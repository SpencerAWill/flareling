# Copy to .env.local (gitignored) for local development; Wrangler v4 reads it
# natively. Deployed, set secrets with `wrangler secret put`. Validated by
# src/env.ts.

# LOG_LEVEL=debug

# Stripe. Locally, the dev container's stripe-mock accepts any sk_test_ key.
STRIPE_SECRET_KEY=sk_test_local
STRIPE_API_BASE=http://stripe-mock:12111
