# Copy to .env.local (gitignored) for local development; Wrangler v4 reads it
# natively. Deployed Workers get vars from wrangler.jsonc and secrets from
# `wrangler secret put`. Every variable here is validated by the schema in
# src/env.ts on the first request.

# Log threshold for @flareling/log: debug | info | warn | error. Unset means
# info. Set to debug on one deployed Worker during an incident.
# LOG_LEVEL=debug

# Where sign-in emails go in development: the dev container's Mailpit inbox,
# at http://localhost:8025 in a host browser.
MAILPIT_URL=http://mailpit:8025

# Turnstile on the sign-in form. Unset skips the check, which is fine locally.
# Cloudflare publishes test keys that always pass or always fail.
# TURNSTILE_SECRET_KEY=

# Stripe billing. Unset turns billing off. Locally, the dev container's
# stripe-mock accepts any sk_test_ key. The webhook secret signs events sent to
# /api/stripe/webhook; `stripe listen` prints one for real test-mode events.
# STRIPE_SECRET_KEY=sk_test_local
# STRIPE_WEBHOOK_SECRET=whsec_local
# STRIPE_API_BASE=http://stripe-mock:12111
