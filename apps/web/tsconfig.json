{
  "extends": "@flareling/config/tsconfig/react.json",
  "compilerOptions": {
    // TanStack Start's guidance: with this on, imports that are only used as
    // types can keep server modules in the client bundle.
    "verbatimModuleSyntax": false,
    "types": ["vite/client", "node", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "src",
    "test",
    "e2e",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
