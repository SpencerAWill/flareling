{
  "name": "@flareling/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "cf-typegen": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "check-worker-size",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:e2e:ui": "playwright test --ui --ui-host 0.0.0.0 --ui-port 9323",
    "test:e2e:report": "playwright show-report --host 0.0.0.0 --port 9323",
    "test:coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:restore-point": "wrangler d1 time-travel info DB --json",
    "rollback": "wrangler rollback --yes"
  },
  "dependencies": {
    "@flareling/auth": "workspace:*",
    "@flareling/billing": "workspace:*",
    "@flareling/contracts": "workspace:*",
    "@flareling/core": "workspace:*",
    "@flareling/email": "workspace:*",
    "@flareling/env": "workspace:*",
    "@flareling/log": "workspace:*",
    "@flareling/ui": "workspace:*",
    "@simplewebauthn/browser": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "jose": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@flareling/config": "workspace:*",
    "@flareling/scripts": "workspace:*",
    "@msw/cloudflare": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "msw": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
