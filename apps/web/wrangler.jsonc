{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Script name in the Cloudflare account. infra/cloudflare attaches custom
  // domains to the Worker by this name, so renaming it means renaming there
  // too.
  "name": "flareling-web",

  // Pinned rather than tracking "today". The compatibility date is the runtime
  // behavior contract, so moving it is a deliberate, tested upgrade. It is set
  // to the build date of the bundled workerd, since local dev cannot emulate
  // dates past the runtime it ships.
  "compatibility_date": "2026-10-01",

  // TanStack Start's server entry uses Node built-ins (node:async_hooks among
  // them) that workerd only exposes behind this flag. Without it the Worker
  // fails at module load, so a deploy succeeds and every request then 500s.
  "compatibility_flags": ["nodejs_compat"],

  // No `limits.cpu_ms`: this template targets Workers Free
  // (docs/adr/0020-target-workers-free.md), where CPU is a fixed 10 ms per
  // request and the setting is rejected at deploy. Server rendering with a
  // session check is close to that, so keep requests lean. On Workers Paid,
  // add `"limits": { "cpu_ms": 300 }` as a guard against runaway requests.

  // Resolved from the installed @tanstack/react-start package: Start owns the
  // fetch handler. This becomes a local module only if the app ever needs a
  // `scheduled` or `queue` handler alongside Start's `fetch`.
  "main": "@tanstack/react-start/server-entry",

  // No `assets` block on purpose. @cloudflare/vite-plugin derives the assets
  // directory from the Vite build and writes the resolved config into the
  // build output, which is what `wrangler deploy` reads.

  // Only the custom domain should serve this app, so the workers.dev URL is
  // off (it would be a second, indexable origin). Preview URLs stay on: they
  // are per-version URLs that PR preview deploys rely on.
  "workers_dev": false,
  "preview_urls": true,

  // Structured logs and traces in the dashboard, and `wrangler tail`.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // The suite's D1 database (libs/db). The id is a placeholder: deploys
  // replace it with infra/cloudflare's `d1DatabaseId` output, and local
  // development and tests use Miniflare's local D1, for which any id works.
  // Migrations come from libs/db; apply them locally with
  // `pnpm --filter @flareling/web db:migrate:local`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flareling-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../libs/db/migrations"
    }
  ],

  // Cloudflare's Rate Limiting binding, used by libs/auth on sign-in routes,
  // keyed per IP and per email address. Limits are per Cloudflare location
  // and eventually consistent, so they slow abuse rather than enforce exact
  // quotas. The namespace id must be unique within the account.
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],

  // The jobs queue, consumed by apps/jobs. The name is the dev stack's;
  // deploys use the target stack's `resourcePrefix`.
  "queues": {
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "flareling-dev-jobs" }]
  },

  // Non-secret configuration, validated by src/env.ts. These are the local
  // development values; deploys override them per environment. Secrets
  // (TURNSTILE_SECRET_KEY, STRIPE_*, RESEND_API_KEY) and dev-only settings
  // (MAILPIT_URL) go in .env.local locally (see .env.example), and are
  // uploaded with each deploy (.github/actions/deploy).
  "vars": {
    "APP_BASE_URL": "http://localhost:3000",
    "APP_NAME": "Flareling",
    // The hostname passkeys are bound to: APP_BASE_URL's host, or a parent
    // domain of it. A passkey made for one RP ID doesn't work on another.
    "WEBAUTHN_RP_ID": "localhost",
    "EMAIL_FROM": "noreply@flareling.localhost",
    "EMAIL_FROM_NAME": "Flareling",
    // The deployed dev outbox (docs/adr/0022-dev-email-outbox.md), set per
    // stack by sync-env. Empty means off; local development uses Mailpit.
    "EMAIL_OUTBOX": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_OUTBOX_AUD": ""
  }
}
