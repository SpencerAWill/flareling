{
  "name": "@flareling/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-time and CI scripts, run directly by Node's type stripping",
  "type": "module",
  "bin": {
    "check-worker-size": "./src/check-worker-size.ts",
    "check-migration-drift": "./src/check-migration-drift.ts",
    "sync-env": "./src/sync-env.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@flareling/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "jsonc-parser": "catalog:"
  }
}
