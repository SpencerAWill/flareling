{
  "extends": "@flareling/config/tsconfig/base.json",
  "compilerOptions": {
    // Workers runtime types (cloudflare:workers, D1, KV, ...), generated by
    // wrangler for the apps' compatibility date, plus Node types for
    // node:async_hooks, which workerd provides under nodejs_compat.
    "types": ["node", "@flareling/config/workers/runtime"]
  },
  "include": ["src", "vitest.config.ts"]
}
