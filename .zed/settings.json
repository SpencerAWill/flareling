// Zed settings for this repo, the counterpart to the VS Code customizations in
// .devcontainer/devcontainer.json. Indentation, line endings, and whitespace
// come from .editorconfig, which Zed reads natively, so none of that is here.
{
  "format_on_save": "on",

  // Biome is the whole toolchain (lint, format, import sorting), so every
  // language it owns is pointed at its language server explicitly.
  // `require_config_file` keeps it from silently formatting with built-in
  // defaults anywhere a config is missing.
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },

  "languages": {
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": { "source.organizeImports.biome": true }
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } }
    }
  },

  // Keeps the editor responsive: scanning node_modules and build output on the
  // bind mount turns every install, build, and test run into a file-event
  // storm.
  //
  // This does NOT fix the .git/index.lock collisions seen under Zed. In
  // ucmc.spencerwill.com, Zed's git integration took the lock ~3 times a second
  // while idle (VS Code: 0), and these exclusions did not change the rate. The
  // mitigations are `lint-staged --no-stash` in .husky/pre-commit and
  // `gc.auto 0` in lifecycle.sh. If a commit leaves every file showing as
  // deleted, `git reset` (mixed, never --hard) restores the index.
  //
  // Exclusions remove paths from the file panel and search entirely, so only
  // uncommitted output and caches belong here. Committed generated files
  // (routeTree.gen.ts, worker-configuration.d.ts) stay visible.
  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/dist",
    "**/.turbo",
    "**/.wrangler",
    "**/.tanstack",
    "**/test-results",
    "**/playwright-report",
    "**/.DS_Store"
  ]
}
