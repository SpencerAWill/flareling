{
  "name": "flareling",
  "version": "0.0.0",
  "description": "GitHub template for shipping a multi-app SaaS suite on Cloudflare",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Spencer Will",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "boundaries": "turbo boundaries",
    "verify": "biome check --error-on-warnings && sherif && knip && pnpm --filter @flareling/db db:drift && turbo run typecheck test && turbo boundaries",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write",
    "format": "biome format --write",
    "lint": "biome lint",
    "commit": "cz",
    "prepare": "husky",
    "sherif": "sherif",
    "size": "turbo run size",
    "test:e2e": "turbo run test:e2e",
    "knip": "knip",
    "test:coverage": "turbo run test:coverage",
    "test:mutation": "stryker run",
    "storybook": "pnpm --filter @flareling/ui storybook",
    "db:generate": "pnpm --filter @flareling/db db:generate"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/cz-commitlint": "catalog:",
    "@stryker-mutator/api": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "commitizen": "catalog:",
    "husky": "catalog:",
    "inquirer": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:mutation"
  }
}
