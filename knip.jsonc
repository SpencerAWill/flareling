{
  // knip: unused files, exports, exported types, and dependencies across the
  // whole workspace. Biome only sees unused locals; knip works on the module
  // graph, so it catches an export nobody imports, a file nothing reaches, or
  // a dependency no source file uses. Runs in `pnpm verify` and CI.
  //
  // Most entry points (Vite, Vitest, Playwright, Wrangler, TanStack Start, the
  // tsconfig presets) are found by knip's plugins. Every setting below exists
  // because a plugin can't see something; each says what and why. Before
  // adding a suppression, check that the finding is a false positive: the
  // point of this file is to keep the signal. Conventions follow
  // ucmc.spencerwill.com's knip.config.ts.
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",

  // An export used only inside its own file is live code with a redundant
  // `export`, not dead code (for example `plan` in infra/github/src/config.ts).
  "ignoreExportsUsedInFile": true,

  // `cloudflare:workers` and `cloudflare:test` are modules the workerd runtime
  // provides, not packages. knip reads the specifier's first segment as a
  // package name.
  "ignoreDependencies": ["cloudflare"],

  // libs/ui's shadcn components are generated by the CLI and kept whole, so
  // they can be compared with (and refreshed from) the registry. Parts of
  // their API that no app uses yet are expected; the public surface that
  // matters is libs/ui/src/index.ts, which knip still checks.
  "ignoreIssues": {
    "libs/ui/src/components/**": ["exports", "types"]
  },

  "workspaces": {
    ".": {
      // Stryker's test project. stryker.config.mjs names it as a string
      // (`vitest.configFile`), which knip can't follow. An entry rather than
      // an ignore, so knip still follows its imports.
      "entry": ["vitest.mutation.config.ts"]
    },
    // Libs are internal, so their public exports are not an API for outside
    // consumers: an export no app or lib imports is dead code. knip skips a
    // package's entry exports by default, which would hide exactly that.
    "libs/*": {
      "includeEntryExports": true
    },
    "apps/web": {
      // The Workers test pool's `main` (see vitest.config.ts). It's referenced
      // by a string in cloudflareTest() options, which knip's Vitest plugin
      // doesn't read, so its default export would report as unused.
      "entry": ["test/worker.ts"]
    },
    "tooling/scripts": {
      // The scripts spawn tools from the calling package's PATH: `wrangler`
      // (check-worker-size, run by apps) and `drizzle-kit`
      // (check-migration-drift, run by libs/db), which those packages already
      // depend on. Declaring them here too would add second copies of things
      // this package never imports.
      "ignoreBinaries": ["wrangler", "drizzle-kit"]
    }
  }
}
