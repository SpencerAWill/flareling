{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**"]
    },
    "size": {
      "dependsOn": ["build"],
      "passThroughEnv": ["GITHUB_STEP_SUMMARY"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CI", "E2E_BASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "lib": {
        "dependencies": {
          "deny": ["app"]
        }
      },
      "tooling": {
        "dependencies": {
          "deny": ["app", "lib"]
        }
      },
      "infra": {
        "dependencies": {
          "deny": ["app"]
        }
      }
    }
  }
}
